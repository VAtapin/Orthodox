{
  "$schema": "https://schemas.wp.org/wp/6.5/theme.json",
  "version": 2,
  "settings": {
    "blocks": {
      "core/image": {"lightbox": {"enabled": true, "allowEditing": true}}
    },
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1200px"
    },
    "color": {
      "palette": [
        {
          "slug": "paper",
          "name": "Background",
          "color": "#faf9f6"
        },
        {
          "slug": "ink",
          "name": "Text",
          "color": "#192133"
        },
        {
          "slug": "forest",
          "name": "Accent",
          "color": "#a46d25"
        },
        {
          "slug": "gold",
          "name": "Gold",
          "color": "#b9863d"
        },
        {
          "slug": "white",
          "name": "Cards",
          "color": "#ffffff"
        },
        {
          "slug": "muted",
          "name": "Secondary text",
          "color": "#687080"
        },
        {
          "slug": "line",
          "name": "Borders",
          "color": "#e5dfd5"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "serif",
          "name": "Serif",
          "fontFamily": "Georgia, 'Times New Roman', serif"
        },
        {
          "slug": "sans",
          "name": "Sans serif",
          "fontFamily": "system-ui, -apple-system, 'Segoe UI', sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.9rem"
        },
        {
          "slug": "medium",
          "name": "Base",
          "size": "1.1rem"
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "1.6rem"
        },
        {
          "slug": "x-large",
          "name": "Heading",
          "size": "2.8rem"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw"
      ],
      "blockGap": true
    },
    "custom": {
      "prihod": {
        "scheme": "classic",
        "radius": "6px",
        "shadow": "0 8px 28px #1b25300d"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|paper",
      "text": "var:preset|color|ink"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "1rem",
      "lineHeight": "1.65"
    },
    "spacing": {
      "padding": {
        "left": "0",
        "right": "0"
      },
      "blockGap": "1.5rem"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontWeight": "400",
          "lineHeight": "1.2"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|forest"
        },
        ":hover": {
          "typography": {
            "textDecoration": "underline"
          }
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|forest",
          "text": "var:preset|color|white"
        },
        "border": {
          "radius": "0.35rem"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "bottom": "0.75rem",
            "left": "1.2rem",
            "right": "1.2rem"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "wide",
      "title": "Wide page",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "focused",
      "title": "Form and confirmation",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "catalog",
      "title": "Content catalog",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "about",
      "title": "History and community",
      "postTypes": [
        "page"
      ]
    }
  ]
}
