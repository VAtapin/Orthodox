msgstr "Kod SMTP"

msgid "Письмо обработано перехватчиком WordPress; фактический транспорт не зафиксирован."
msgstr "Wiadomość została obsłużona przez przechwytywanie WordPress; faktyczny transport nie został zarejestrowany."

msgid "Этапы:"
msgstr "Etapy:"

msgid "Письмо подготовлено"
msgstr "Wiadomość przygotowana"

