msgstr "Przypisany Message-ID"

msgid "ID попытки"
msgstr "ID próby"

msgid "Код ошибки"
msgstr "Kod błędu"

msgid "Тип исключения"
msgstr "Typ wyjątku"

msgid "Код исключения"
msgstr "Kod wyjątku"

