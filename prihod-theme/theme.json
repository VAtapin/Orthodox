{
  "$schema": "https://schemas.wp.org/wp/6.5/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {"contentSize": "760px", "wideSize": "1200px"},
    "color": {"palette": [
      {"slug":"paper","name":"Бумага","color":"#f7f4ec"},
      {"slug":"ink","name":"Текст","color":"#252b2a"},
      {"slug":"forest","name":"Зелёный","color":"#183c36"},
      {"slug":"gold","name":"Золото","color":"#a98545"},
      {"slug":"white","name":"Белый","color":"#ffffff"}
    ]},
    "typography": {
      "fluid": true,
      "fontFamilies": [{"slug":"serif","name":"Книжный","fontFamily":"Georgia, 'Times New Roman', serif"},{"slug":"sans","name":"Простой","fontFamily":"system-ui, -apple-system, 'Segoe UI', sans-serif"}],
      "fontSizes": [{"slug":"small","name":"Малый","size":"0.9rem"},{"slug":"medium","name":"Основной","size":"1.1rem"},{"slug":"large","name":"Большой","size":"1.6rem"},{"slug":"x-large","name":"Заголовок","size":"2.8rem"}]
    },
    "spacing": {"units":["px","rem","%","vw"],"blockGap":true}
  },
  "styles": {
    "color":{"background":"var:preset|color|paper","text":"var:preset|color|ink"},
    "typography":{"fontFamily":"var:preset|font-family|sans","fontSize":"var:preset|font-size|medium","lineHeight":"1.7"},
    "spacing":{"padding":{"left":"clamp(1rem, 4vw, 3rem)","right":"clamp(1rem, 4vw, 3rem)"},"blockGap":"1.5rem"},
    "elements":{
      "heading":{"typography":{"fontFamily":"var:preset|font-family|serif","fontWeight":"400","lineHeight":"1.2"}},
      "link":{"color":{"text":"var:preset|color|forest"},":hover":{"typography":{"textDecoration":"underline"}}},
      "button":{"color":{"background":"var:preset|color|forest","text":"var:preset|color|white"},"border":{"radius":"0.35rem"},"spacing":{"padding":{"top":"0.75rem","bottom":"0.75rem","left":"1.2rem","right":"1.2rem"}}}
    }
  },
  "templateParts":[{"name":"header","title":"Шапка","area":"header"},{"name":"footer","title":"Подвал","area":"footer"}]
}
