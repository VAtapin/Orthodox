msgstr "На этой странице обращений нет."

msgid "There is no technical log for this reply. Past delivery attempts cannot be reconstructed retroactively."
msgstr "Для этого ответа технический журнал отсутствует. Старые отправки не восстанавливаются задним числом."

msgid "This is the Meta Graph API version used in request URLs, not a key or plugin version. Copy a supported version from Graph API Explorer, for example vNN.N."
msgstr "Это версия Meta Graph API, используемая в адресах запросов, а не ключ и не версия плагина. Скопируйте поддерживаемую версию из Graph API Explorer, например vNN.N."

msgid "This is the VK API method version, not a token. Copy it from the method documentation, for example 5.199, without a v prefix."
msgstr "Это версия API VK, а не токен. Скопируйте её из документации метода, например 5.199, без префикса v."

msgid "This publication cannot be changed."
msgstr "Состояние этой публикации не допускает изменение."

msgid "This reply cannot be resent."
msgstr "Ответ недоступен для повторной отправки."

