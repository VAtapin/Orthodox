msgid "Contact us"
msgstr "Kontaktieren Sie uns"

msgid "Send message"
msgstr "Nachricht senden"

msgid "Введите свою тему вопроса."
msgstr "Bitte geben Sie einen Betreff ein."

msgid "Обращение принято. Ответ придёт по email."
msgstr "Ihre Nachricht wurde empfangen. Sie erhalten eine Antwort per E-Mail."

msgid "Обращение не отправлено. Проверьте поля или повторите позже."
msgstr "Die Nachricht konnte nicht gesendet werden. Prüfen Sie die Angaben oder versuchen Sie es später erneut."

msgid "Поля со звёздочкой обязательны для заполнения."
msgstr "Mit einem Stern markierte Felder sind Pflichtfelder."

msgid "Ваше имя"
msgstr "Ihr Name"

msgid "Введите ваше имя"
msgstr "Geben Sie Ihren Namen ein"

msgid "Ваш email"
msgstr "Ihre E-Mail-Adresse"

msgid "Тема вопроса"
msgstr "Betreff"

msgid "Выберите тему"
msgstr "Betreff auswählen"

msgid "Другая тема"
msgstr "Anderer Betreff"

msgid "Для другой темы укажите своё название в поле ниже."
msgstr "Geben Sie den Betreff im folgenden Feld ein."

msgid "Своя тема вопроса"
msgstr "Eigener Betreff"

msgid "Введите свою тему вопроса"
msgstr "Geben Sie einen Betreff ein"

msgid "Текст обращения"
msgstr "Ihre Nachricht"

msgid "Опишите ваш вопрос…"
msgstr "Schreiben Sie Ihre Nachricht…"

msgid "Оставьте поле пустым"
msgstr "Dieses Feld leer lassen"

msgid "Согласен на обработку данных для ответа на обращение."
msgstr "Ich stimme der Verarbeitung meiner Daten zur Beantwortung meiner Nachricht zu."

msgid "Политика конфиденциальности"
msgstr "Datenschutzerklärung"
